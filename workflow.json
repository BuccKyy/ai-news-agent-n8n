        "conditions": {
          "number": [
            {
              "value1": "={{ $json.ai_response.score }}",
              "operation": "largerEqual",
              "value2": 7
            }
          ]
        }
      },
      "name": "Filter Score >= 7",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1872,
        560
      ],
      "id": "ff082627-2b7e-46f6-b554-0ecb2c8f5bb6"
    },
    {
      "parameters": {
        "jsCode": "// IMPROVEMENT #1: PRIORITY QUEUE - Sort by score DESC\nconst items = $input.all();\nconst sorted = items.sort((a, b) => {\n  const scoreA = a.json.ai_response?.score || 0;\n  const scoreB = b.json.ai_response?.score || 0;\n  return scoreB - scoreA;\n});\nconst limited = sorted.slice(0, 5);\n\n// Helper to escape HTML special characters\nconst escapeHTML = (text) => {\n  if (!text) return '';\n  return text.toString().replace(/[&<>\"]/g, (m) => ({\n    '&': '&amp;',\n    '<': '&lt;',\n    '>': '&gt;',\n    '\"': '&quot;'\n  }[m]));\n};\n\nreturn limited.map((item, idx) => {\n  const d = item.json;\n  const ai = d.ai_response;\n  const kp = ai.key_points?.length > 0 ? ai.key_points.map(p => `  • ${escapeHTML(p)}`).join('\\n') : '  • Xem chi tiết';\n  \n  const msg = `<b>TIÊU ĐỀ: ${escapeHTML(d.title.toUpperCase())}</b>\\n\\nĐiểm: ${ai.score}/10 | Category: ${escapeHTML(ai.category.replace('_', ' '))}\\nKhuyến nghị: ${escapeHTML(ai.recommendation)}\\nSắc thái: ${escapeHTML(ai.sentiment || 'N/A')} | Tầm quan trọng: ${escapeHTML(ai.impact || 'N/A')}\\n\\nTóm tắt:\\n${escapeHTML(ai.summary)}\\n\\nĐiểm nổi bật:\\n${kp}\\n\\nLink bài viết: ${d.url}\\n\\nThời gian: ${new Date().toLocaleString('vi-VN', {timeZone: 'Asia/Ho_Chi_Minh'})}`;\n  const itemId = Date.now() + '_' + idx;\n  return {\n    json: {\n      ...d,\n      telegram_message: msg,\n      item_id: itemId,\n      inline_keyboard: [[{text: '📖 Đọc ngay', url: d.url}, {text: '⭐ Lưu lại', callback_data: `save_${itemId}`}], [{text: '❌ Bỏ qua', callback_data: `skip_${itemId}`}]]\n    }\n  };\n});"
      },
      "name": "Priority Sort & Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2192,
        256
      ],
      "id": "1b54b6db-8414-4ef5-a0cc-b3d021f69c4d"
