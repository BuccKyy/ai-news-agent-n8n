    {
      "parameters": {
        "jsCode": "// NORMALIZE & DEDUPLICATE\nconst staticData = $getWorkflowStaticData('global');\nconst now = new Date();\nconst hour = parseInt(now.toLocaleTimeString('vi-VN', {timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', hour12: false}));\n\n// 1. Hour Filter (7:00-24:00)\nif (hour < 7) {\n  const queuedItems = staticData.queuedItems || [];\n  const newItems = $input.all().map(i => i.json);\n  staticData.queuedItems = [...queuedItems, ...newItems].slice(-100);\n  return [];\n}\n\nlet items = $input.all();\nif (hour === 7 && staticData.queuedItems?.length > 0) {\n  items = [...staticData.queuedItems.map(json => ({json})), ...items];\n  staticData.queuedItems = [];\n}\n\n// 2. Heavy Deduplication\nconst sentUrls = new Set((staticData.sentUrls || []).map(u => u.toLowerCase().replace(/\\/+$/, '')));\nconst results = [];\nconst seenInBatch = new Set();\n\nfor (const item of items) {\n  let url = item.json.link || item.json.url || item.json.guid;\n  if (!url) continue;\n  \n  // Normalize URL\n  const normUrl = url.toLowerCase().trim().replace(/\\/+$/, '');\n  \n  if (sentUrls.has(normUrl) || seenInBatch.has(normUrl)) continue;\n  seenInBatch.add(normUrl);\n  \n  let desc = item.json.description || item.json.content || item.json.summary || '';\n  desc = desc.replace(/<[^>]*>/g, '').substring(0, 300);\n  const isYT = url.includes('youtube.com') || url.includes('youtu.be');\n\n  results.push({\n    json: {\n      title: item.json.title || 'No title',\n      description: desc,\n      url: url,\n      normUrl: normUrl, // Keep for internal tracking\n      source: item.json.source || item.json.creator || item.json.author || 'Unknown',\n      pubDate: item.json.pubDate || item.json.isoDate || new Date().toISOString(),\n      isVideo: isYT,\n      mediaType: isYT ? '🎬 Video' : '📄 Article'\n    }\n  });\n}\n\n// 3. Limit processing to 5 items per batch for absolute safety\nconst finalItems = results.slice(0, 5);\n\n// 4. Update memory IMMEDIATELY to prevent double-processing if workflow restarts\nconst newSent = [...(staticData.sentUrls || []), ...finalItems.map(i => i.json.normUrl)];\nstaticData.sentUrls = newSent.slice(-5000); // Keep last 5000\n\nreturn finalItems;"
      },
      "name": "Smart Timing & Clean",
