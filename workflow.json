    {
      "parameters": {
        "promptType": "define",
        "text": "=Bạn là AI chuyên gia phân tích tin tức AI/Tech. Phân tích:\n\nTitle: {{ $json.title }}\nDescription: {{ $json.description }}\nURL: {{ $json.url }}\nMedia: {{ $json.mediaType }}\n\nTrả về CHỈ JSON:\n{\"summary\": \"tóm tắt 2-3 câu tiếng Việt\", \"score\": 8, \"category\": \"LLM\", \"sentiment\": \"Tích cực\", \"impact\": \"Cao\", \"key_points\": [\"điểm 1\", \"điểm 2\"], \"recommendation\": \"must_read\"}\n\nCategories: LLM, ML_Research, Computer_Vision, NLP, AI_Tools, AI_Coding, AI_Products, AI_Ethics, Robotics, Tutorial, General_Tech\nScore: 9-10 breakthrough, 7-8 important, 5-6 interesting, 1-4 skip"
      },
      "name": "AI Analysis",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1200,
        336
      ],
      "id": "0c71d5e5-2963-459e-bec0-c5ccb15e8ba2",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// IMPROVEMENT #4: PERSONAL INTEREST FILTER\nconst items = $input.all();\nconst staticData = $getWorkflowStaticData('global');\nconst favorites = staticData.favoriteCategories || ['LLM', 'AI_Coding', 'AI_Tools'];\nconst results = [];\n\n// Get original data from the loop start node to prevent data loss\nconst originalItem = $('Process One by One').item.json;\n\nfor (const item of items) {\n  try {\n    let resp = item.json.response?.text || item.json.text || item.json.output || JSON.stringify(item.json);\n    const m = resp.match(/\\{[\\s\\S]*\\}/);\n    if (m) {\n      const p = JSON.parse(m[0]);\n      let score = Math.min(10, Math.max(1, parseInt(p.score) || 5));\n      \n      // BOOST score for favorite categories\n      if (favorites.includes(p.category)) {\n        score = Math.min(10, score + 2);\n      }\n      \n      results.push({\n        json: {\n          title: originalItem.title || item.json.title || 'No title',\n          description: originalItem.description || item.json.description || '',\n          url: originalItem.url || item.json.url || '',\n          source: originalItem.source || item.json.source || 'Unknown',\n          pubDate: originalItem.pubDate || item.json.pubDate || '',\n          isVideo: originalItem.isVideo || item.json.isVideo || false,\n          mediaType: originalItem.mediaType || item.json.mediaType || '📄 Article',\n          ai_response: {\n            summary: p.summary || 'Không có tóm tắt',\n            score: score,\n            originalScore: parseInt(p.score) || 5,\n            category: p.category || 'General_Tech',\n            key_points: p.key_points || [],\n            recommendation: p.recommendation || 'optional',\n            sentiment: p.sentiment || 'N/A',\n            impact: p.impact || 'N/A',\n            isFavorite: favorites.includes(p.category)\n          }\n        }\n      });\n    }\n  } catch (e) { console.log('Parse error:', e.message); }\n}\nreturn results;"
      },
      "name": "Parse & Boost Favorites",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
